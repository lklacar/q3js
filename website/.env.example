NEXT_PUBLIC_Q3JS_MASTER_URL=http://localhost:8080
Q3JS_MASTER_URL=http://localhost:8080

# Canonical production origin used by metadata, structured data, robots, and sitemap.
NEXT_PUBLIC_Q3JS_SITE_URL=https://q3js.com

# Optional dedicated origin for PK3 manifests and files. Defaults to the website origin.
# NEXT_PUBLIC_Q3JS_STATIC_URL=https://static.q3js.com

# The existing Q3JS Google Analytics property. Override or leave blank in deployments
# that use a different property.
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-X7L740SND7

# Optional Google Search Console verification token.
# GOOGLE_SITE_VERIFICATION=

# Set this in production when the main site is HTTPS but a development game
# server only offers an insecure WebSocket endpoint.
# NEXT_PUBLIC_Q3JS_INSECURE_PLAY_URL=http://localhost:3000
