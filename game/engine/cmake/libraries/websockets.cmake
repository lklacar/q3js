if(NOT BUILD_SERVER OR EMSCRIPTEN)
    return()
endif()

include(FetchContent)
set(LWS_WITH_SHARED OFF CACHE BOOL "" FORCE)
set(LWS_WITH_SSL OFF CACHE BOOL "" FORCE)
set(LWS_WITH_HTTP2 OFF CACHE BOOL "" FORCE)
set(LWS_WITHOUT_CLIENT ON CACHE BOOL "" FORCE)
set(LWS_WITHOUT_TESTAPPS ON CACHE BOOL "" FORCE)
set(LWS_WITH_EXTERNAL_POLL ON CACHE BOOL "" FORCE)
set(LWS_IPV6 ON CACHE BOOL "" FORCE)
set(DISABLE_WERROR ON CACHE BOOL "" FORCE)
FetchContent_Declare(libwebsockets
    URL https://codeload.github.com/warmcat/libwebsockets/tar.gz/refs/tags/v4.3.5
    URL_HASH SHA256=87f99ad32803ed325fceac5327aae1f5c1b417d54ee61ad36cffc8df5f5ab276
    DOWNLOAD_EXTRACT_TIMESTAMP TRUE)
set(CMAKE_POLICY_VERSION_MINIMUM 3.5)
set(CMAKE_EXPORT_NO_PACKAGE_REGISTRY ON)
FetchContent_MakeAvailable(libwebsockets)
file(GENERATE OUTPUT "${CMAKE_BINARY_DIR}/$<CONFIG>/licenses/libwebsockets.txt"
    INPUT "${libwebsockets_SOURCE_DIR}/LICENSE")
list(APPEND SERVER_DEFINITIONS USE_NATIVE_WEBSOCKETS)
list(APPEND SERVER_LIBRARY_SOURCES ${SOURCE_DIR}/qcommon/net_websocket.c)
list(APPEND SERVER_LIBRARIES websockets)
